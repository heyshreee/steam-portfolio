{
  "name": "steam-portfolio-template",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A modern, animated developer portfolio template built with React 19, TypeScript, Vite, Tailwind CSS v4, Framer Motion and Anime.js. Customize one config file and deploy.",
  "keywords": [
    "portfolio",
    "portfolio-template",
    "react",
    "typescript",
    "vite",
    "tailwindcss",
    "framer-motion",
